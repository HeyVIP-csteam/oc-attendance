{
  "name": "tg-attendance",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram Forum-Topic attendance system on Cloudflare Workers + D1 with a React dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:api": "wrangler dev",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrations:list": "wrangler d1 migrations list DB --remote",
    "db:seed:demo:local": "node scripts/demo-seed.mjs > .wrangler/demo-seed.sql && wrangler d1 execute DB --local --file .wrangler/demo-seed.sql",
    "admin:create": "node scripts/create-admin.mjs",
    "simulate": "node scripts/simulate.mjs",
    "deploy": "npm run build && wrangler deploy",
    "logs": "wrangler tail"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.12",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
